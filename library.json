        },
        {
            "name": "Joris Vandalon (ring mode)"
        }
    ],
    "frameworks": [
        "arduino",
        "espidf"
    ],
    "platforms": [
        "espressif32"
    ],
    "headers": [
        "ESP32-HUB75-MatrixPanel-I2S-DMA.h",
        "ESP32-VirtualMatrixPanel-I2S-DMA.h"
    ],
    "examples": [
        {
            "name": "SimpleTestShapes",
